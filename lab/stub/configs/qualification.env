# Static qualification scenario. Candidate and controller release data belong
# in an external per-run manifest and are intentionally absent here.
SCHEMA_VERSION=1
PROFILE=unifi-stubd-lab
GUEST_USER=alpine
GUEST_FORWARD_HOST=127.0.0.1
CORE_TARGET=integration-nonunifi-metrics
CORE_CLEANUP_TARGET=integration-tier3-candidate-controller-cleanup
CORE_INPUT_RELATIVE_DIR=dist/tier3-controller-input
GUEST_ROOT_RELATIVE_PATH=.local/share/unifi-stubd-tier3
GUEST_STAGE_RELATIVE_PATH=.unifi-stubd-tier3
SERVICE_NAME=unifi-stubd
FIXTURE_LINKS=stubbr0,uplink0,uplinkp0
READY_TIMEOUT_SECONDS=300
RESULT_TIMEOUT_SECONDS=900
CORE_TERMINATE_TIMEOUT_SECONDS=90
SSH_CONNECT_TIMEOUT_SECONDS=5
PRODUCT_INTERRUPT_TIMEOUT_SECONDS=20
PRODUCT_TERMINATE_TIMEOUT_SECONDS=10
TRAFFIC_INGRESS_TARGET=203.0.113.1
TRAFFIC_EGRESS_TARGET=203.0.113.2
